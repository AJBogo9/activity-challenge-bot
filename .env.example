# ======================
# Environment
# ======================
NODE_ENV=development

# ======================
# Telegram Bot
# ======================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ======================
# Mini App Configuration
# ======================
WEBAPP_URL=https://your-domain.com
API_PORT=3001

# ======================
# Cloudflare Tunnel
# ======================
# Create a tunnel at dash.cloudflare.com > Zero Trust > Networks > Tunnels
# Point it to http://app:3001, then paste the tunnel token below
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ======================
# PostgreSQL Database
# ======================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=activity_challenge_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/activity_challenge_bot